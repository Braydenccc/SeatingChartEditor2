{
  "name": "seat-chart-editor-v2",
  "version": "26.7.1502-3238",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "cross-env EDITOR=antigravity vite",
    "dev:lan": "cross-env EDITOR=antigravity vite --host 0.0.0.0",
    "build": "npm run build:web",
    "build:web": "vue-tsc --noEmit && vite build",
    "build:test": "node scripts/build-test.js",
    "build:desktop": "tauri build",
    "build:desktop:win": "tauri build --bundles nsis,msi",
    "preview": "vite preview",
    "deploy:main": "git checkout main && git merge @{-1} --no-edit && git push origin main && git checkout @{-1}",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:build-test": "node --test test-scr/build-test-safety.test.js",
    "test:student": "vitest run src/composables/__tests__/useStudentData.test.ts",
    "test:seat": "vitest run src/composables/__tests__/useSeatChart.test.ts",
    "test:assignment": "vitest run src/composables/__tests__/useAssignment.test.ts",
    "test:integration": "vitest run src/composables/__tests__/integration.test.ts",
    "test:edge": "vitest run src/composables/__tests__/edge-cases.test.ts",
    "test:ci": "vitest run --coverage --reporter=dot --reporter=json --reporter=html",
    "docs:sync": "node scripts/sync-agent-docs.js",
    "docs:check": "node scripts/check-agent-docs.js",
    "version:timestamp": "node scripts/set-release-version.js",
    "version:check": "node scripts/set-release-version.js --check"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@vueuse/core": "^14.2.1",
    "bcryptjs": "^3.0.3",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "2.44.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.1.0",
    "happy-dom": "^14.12.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.2.7"
  },
  "description": "A Vue and Tauri classroom seating chart editor.",
  "keywords": [
    "seat-chart",
    "classroom",
    "tauri",
    "vue"
  ],
  "author": "Braydenccc",
  "license": "GPL-3.0-or-later",
